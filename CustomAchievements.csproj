<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>CustomAchievements</RootNamespace>
		<AssemblyName>CustomAchievements</AssemblyName>
		<TargetFramework>net472</TargetFramework>
		<Deterministic>true</Deterministic>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<PackageId>CustomAchievements</PackageId>
		<Description>Custom achievements for DSP mods, stored outside the vanilla achievement file.</Description>
		<Version>0.2.0</Version>
		<Authors>cat-yummi</Authors>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<NoWarn>$(NoWarn);NU1605;MSB3277</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<DebugType>full</DebugType>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.4.17" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.53" IncludeAssets="compile" />
		<PackageReference Include="DysonSphereProgram.GameLibs" Version="*-*" />
		<ProjectReference Include="..\CatAPI\plugin\CatAPI.csproj" Private="false" />
		<EmbeddedResource Include="res\default_icon.png" LogicalName="CustomAchievements.res.default_icon.png" />
	</ItemGroup>
	<PropertyGroup>
		<ProfileDir Condition=" '$(ProfileDir)' == '' ">$(APPDATA)\r2modmanPlus-local\DysonSphereProgram\profiles\CatAPI</ProfileDir>
		<DeployDir>$(ProfileDir)\BepInEx\plugins\cat_yummi-$(AssemblyName)</DeployDir>
	</PropertyGroup>
	<Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
		<Copy SourceFiles="$(TargetPath);icon.png;manifest.json;README.md;CHANGELOG.md" DestinationFolder="$(DeployDir)" Retries="0" ContinueOnError="WarnAndContinue" />
		<Message Importance="high" Text="已部署到 $(DeployDir)" Condition=" '$(MSBuildLastTaskResult)' == 'true' " />
		<Message Importance="high" Text="部署失败：游戏可能正在运行，关闭游戏后重新编译即可" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
	</Target>
</Project>
